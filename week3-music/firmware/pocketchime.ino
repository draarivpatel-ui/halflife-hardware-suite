// PocketChime-R2R firmware: 8-bit R-2R ladder chiptune synthesizer.
// Target: RP2040-Zero (Arduino RP2040 core), 12-key chromatic tactile matrix,
// MCP6002-I/SN rail-to-rail buffer on a 3.5 mm TRS jack.
//
// Four voice phase accumulator DDS plus a four stage ADSR envelope generator.
// The 8 GPIO bits of PORT_DAC are driven as a single bus write so that the
// R-2R ladder settles in one cycle. Timer ISR runs at SAMPLE_RATE Hz.
//
// No audio is generated by the browser workbench. This file is firmware only.

#include <Arduino.h>

static const uint32_t SAMPLE_RATE = 22050;
static const uint8_t DAC_PINS[8] = {2, 3, 4, 5, 6, 7, 8, 9};
static const uint8_t ROW_PINS[3] = {10, 11, 12};
static const uint8_t COL_PINS[4] = {13, 14, 15, 26};
static const uint8_t NUM_VOICES = 4;
static const uint8_t NUM_KEYS = 12;

// Phase accumulator increment = f * 2^32 / sample_rate, computed at note on.
static const uint32_t PHASE_SCALE = 4294967296ULL / SAMPLE_RATE;

enum EnvStage : uint8_t { STAGE_IDLE = 0, STAGE_ATTACK, STAGE_DECAY, STAGE_SUSTAIN, STAGE_RELEASE };

struct Voice {
  uint32_t phase;
  uint32_t increment;
  uint16_t level;       // 0..4095, envelope output in Q12
  uint8_t stage;
  uint8_t waveform;     // 0 pulse, 1 triangle, 2 saw, 3 square
  uint8_t duty;         // pulse duty as a 0..255 compare value
  uint16_t tick;        // stage progress in sample ticks
  uint16_t attack;
  uint16_t decay;
  uint16_t sustain;     // Q12 sustain level
  uint16_t release_t;
  uint8_t note;
  bool gate;
};

static Voice voices[NUM_VOICES];
static volatile int16_t mixOut = 0;
static uint8_t voiceCursor = 0;

// Equal temperament chromatic semitone frequencies in Hz, C4 to B4.
static const uint16_t NOTE_HZ[NUM_KEYS] = {
  262, 277, 294, 311, 330, 349, 370, 392, 415, 440, 466, 494
};

static inline void dacWrite(uint8_t code) {
  // Eight GPIO writes on one logical bus. On RP2040 this compiles to a
  // masked GPIO_OUT write when the pins are contiguous, which they are here.
  uint32_t bits = 0;
  for (uint8_t i = 0; i < 8; i++) bits |= ((code >> i) & 1U) << DAC_PINS[i];
  gpio_put_masked(0xFF << DAC_PINS[0], bits);
}

static inline uint16_t envelopeStep(Voice &v) {
  switch (v.stage) {
    case STAGE_ATTACK:
      v.tick++;
      v.level = (uint16_t)(((uint32_t)v.tick * 4095U) / (v.attack ? v.attack : 1));
      if (v.tick >= v.attack) { v.stage = STAGE_DECAY; v.tick = 0; }
      break;
    case STAGE_DECAY: {
      v.tick++;
      const uint32_t span = (uint32_t)(4095U - v.sustain);
      const uint32_t fall = (v.decay ? (uint32_t)v.tick * span / v.decay : span);
      v.level = (fall < 4095U) ? (uint16_t)(4095U - fall) : v.sustain;
      if (v.tick >= v.decay) { v.stage = STAGE_SUSTAIN; v.tick = 0; v.level = v.sustain; }
      break;
    }
    case STAGE_SUSTAIN:
      v.level = v.sustain;
      if (!v.gate) { v.stage = STAGE_RELEASE; v.tick = 0; }
      break;
    case STAGE_RELEASE: {
      v.tick++;
      const uint32_t start = v.level;
      const uint32_t fall = v.release_t ? (uint32_t)v.tick * start / v.release_t : start;
      v.level = (fall < start) ? (uint16_t)(start - fall) : 0;
      if (v.tick >= v.release_t) { v.stage = STAGE_IDLE; v.level = 0; }
      break;
    }
    default:
      v.level = 0;
      break;
  }
  return v.level;
}

static inline int16_t oscillator(const Voice &v) {
  const uint32_t ph = v.phase;
  uint16_t sample = 0;
  switch (v.waveform) {
    case 0: { // pulse with variable duty
      const uint8_t hi = (uint8_t)(ph >> 24);
      sample = (hi < v.duty) ? 4095 : 0;
      break;
    }
    case 1: { // triangle
      const uint16_t top = (uint16_t)(ph >> 16);
      sample = (top & 0x8000) ? (uint16_t)(0xFFFF - top) >> 3 : (uint16_t)(top >> 3);
      break;
    }
    case 2: // saw
      sample = (uint16_t)(ph >> 20);
      break;
    default: // square
      sample = (ph & 0x80000000U) ? 4095 : 0;
      break;
  }
  return (int16_t)(sample - 2048);
}

static inline void synthTick() {
  int32_t acc = 0;
  for (uint8_t i = 0; i < NUM_VOICES; i++) {
    Voice &v = voices[i];
    if (v.stage == STAGE_IDLE) continue;
    v.phase += v.increment;
    const uint16_t env = envelopeStep(v);
    acc += ((int32_t)oscillator(v) * (int32_t)env) >> 12;
  }
  acc /= (int32_t)NUM_VOICES;
  if (acc > 2047) acc = 2047;
  if (acc < -2048) acc = -2048;
  mixOut = (int16_t)acc;
  dacWrite((uint8_t)((acc + 2048) >> 4));
}

// Hardware timer alarm ISR. Registered with the RP2040 SDK repeating timer.
static struct repeating_timer synthTimer;
static bool IRAM_ATTR onTimer(struct repeating_timer *t) {
  (void)t;
  synthTick();
  return true;
}

static void noteOn(uint8_t key) {
  const uint16_t hz = NOTE_HZ[key % NUM_KEYS];
  Voice &v = voices[voiceCursor];
  voiceCursor = (voiceCursor + 1) % NUM_VOICES;
  v.phase = 0;
  v.increment = (uint32_t)((uint64_t)hz * PHASE_SCALE);
  v.level = 0;
  v.tick = 0;
  v.waveform = (key / 4) % 4;
  v.duty = 64 + (key % 4) * 32;
  v.attack = 32;
  v.decay = 180;
  v.sustain = 2400;
  v.release_t = 320;
  v.note = key;
  v.gate = true;
  v.stage = STAGE_ATTACK;
}

static void noteOff(uint8_t key) {
  for (uint8_t i = 0; i < NUM_VOICES; i++) {
    if (voices[i].note == key && voices[i].gate) voices[i].gate = false;
  }
}

static bool keyState[NUM_KEYS];

static void scanKeys() {
  for (uint8_t r = 0; r < 3; r++) {
    for (uint8_t rr = 0; rr < 3; rr++) digitalWrite(ROW_PINS[rr], rr == r ? LOW : HIGH);
    delayMicroseconds(8);
    for (uint8_t c = 0; c < 4; c++) {
      const uint8_t key = r * 4 + c;
      const bool pressed = (digitalRead(COL_PINS[c]) == LOW);
      if (pressed && !keyState[key]) noteOn(key);
      else if (!pressed && keyState[key]) noteOff(key);
      keyState[key] = pressed;
    }
  }
  for (uint8_t rr = 0; rr < 3; rr++) digitalWrite(ROW_PINS[rr], HIGH);
}

void setup() {
  for (uint8_t i = 0; i < 8; i++) { pinMode(DAC_PINS[i], OUTPUT); digitalWrite(DAC_PINS[i], LOW); }
  for (uint8_t r = 0; r < 3; r++) { pinMode(ROW_PINS[r], OUTPUT); digitalWrite(ROW_PINS[r], HIGH); }
  for (uint8_t c = 0; c < 4; c++) pinMode(COL_PINS[c], INPUT_PULLUP);
  for (uint8_t i = 0; i < NUM_VOICES; i++) voices[i] = Voice{};
  dacWrite(128); // mid scale, zero AC output
  add_repeating_timer_us(-1000000L / SAMPLE_RATE, onTimer, nullptr, &synthTimer);
}

void loop() {
  scanKeys();
  delay(2);
}
